{
  "schema_version": "1.1",
  "mode": "HARD_STRUCTURAL_MEMORY",
  "selection_pipeline": [
    "resolve semantic role and content shape",
    "load GitHub structural history index",
    "select recent + same-niche + nearest structural comparison set",
    "build recent-role exclusion set",
    "filter bank by semantic/content/media/a11y/responsive constraints",
    "group candidates by topology cluster",
    "uniformly sample an underused eligible cluster",
    "sample archetype inside cluster",
    "sample additional compatible modifier overrides from axes.json",
    "render neutral wireframe fingerprint",
    "compare against same-page, same-site and recent cross-site fingerprints",
    "reroll or mutate when distance fails",
    "synthesize a new grammar when no distant candidate survives",
    "build and QA site",
    "write or update canonical per-site fingerprint file",
    "update history index frequencies and recency",
    "read written per-site file and index back from main branch",
    "record STRUCTURAL_MEMORY_WRITE_PASS only after read-after-write verification"
  ],
  "hard_rules": {
    "cosmetic_only_change_is_unique": false,
    "left_right_mirror_is_unique": false,
    "color_change_is_unique": false,
    "image_swap_is_unique": false,
    "radius_change_is_unique": false,
    "class_name_change_is_unique": false,
    "exact_structural_signature_repeat_same_site": 0,
    "adjacent_same_topology_cluster_allowed": false,
    "hero_equals_final_cta_stage_allowed": false,
    "same_home_sequence_on_unrelated_recent_site_allowed": false,
    "per_site_history_file_required_after_new_build": true,
    "history_index_update_required_after_new_build": true,
    "read_after_write_verification_required": true,
    "duplicate_same_domain_history_files_allowed": false
  },
  "distance_thresholds": {
    "adjacent_major_sections": 0.66,
    "same_role_same_site": 0.7,
    "new_hero_vs_last_12": 0.78,
    "new_footer_vs_last_10": 0.74,
    "home_vs_recent_20": 0.72,
    "key_internal_vs_sibling": 0.64,
    "mobile_page_silhouette_vs_recent": 0.64
  },
  "site_similarity_weights": {
    "hero_topology": 0.12,
    "home_section_sequence": 0.16,
    "macro_topology_distribution": 0.13,
    "content_anchor_distribution": 0.08,
    "media_topology_rhythm": 0.1,
    "surface_rhythm": 0.07,
    "card_list_geometry": 0.07,
    "transition_rhythm": 0.06,
    "interaction_profile": 0.05,
    "mobile_transform_profile": 0.06,
    "header_family": 0.04,
    "footer_family": 0.04,
    "cta_closing_family": 0.02
  },
  "cooldown_windows": {
    "hero_topology_cluster": 8,
    "hero_exact_archetype": 16,
    "footer_topology_cluster": 6,
    "footer_exact_archetype": 12,
    "faq_exact_archetype": 6,
    "cta_exact_archetype": 8,
    "process_exact_archetype": 6,
    "editorial_exact_archetype": 6,
    "page_rhythm_recipe": 10,
    "home_bigram_sequence": 12,
    "home_trigram_sequence": 20
  },
  "page_targets": {
    "rich_home_min_unique_topology_ratio": 0.86,
    "key_page_min_unique_topology_ratio": 0.78,
    "max_same_topology_on_rich_page": 2,
    "max_consecutive_card_dominant_sections": 1,
    "min_materially_different_openings_across_home_plus_3_key_pages": 4
  },
  "reroll_policy": {
    "max_standard_rerolls": 12,
    "order": [
      "different archetype same underused cluster",
      "different eligible cluster",
      "mutate shell + content anchor + media topology",
      "mutate page rhythm recipe",
      "synthesize new grammar from axes",
      "record NEW_GRAMMAR_CREATED"
    ]
  },
  "history_read_policy": {
    "always_load": "site-factory-history/index.json",
    "inspect_recent_sites": 30,
    "inspect_same_niche_sites": 30,
    "inspect_nearest_structural_matches": 20,
    "full_detail_files_loaded_after_index_filter": 20
  },
  "history_write_policy": {
    "canonical_path_pattern": "site-factory-history/sites/{normalized-domain}.json",
    "new_domain_action": "CREATE",
    "existing_domain_action": "UPDATE_EXISTING_CANONICAL_FILE",
    "update_index": "site-factory-history/index.json",
    "preserve_revision_summary": true,
    "verify_by_refetch": true,
    "success_state": "STRUCTURAL_MEMORY_WRITE_PASS",
    "blocked_state": "STRUCTURAL_MEMORY_WRITE_BLOCKED",
    "disallowed_content": [
      "public page copy",
      "prompts",
      "credentials",
      "secrets",
      "private user data",
      "unnecessary personal information"
    ]
  }
}
